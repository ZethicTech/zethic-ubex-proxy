# fc-proxy configuration.
#
# Copy this file next to the binary as "fc-proxy.env" and fill it in. The proxy
# loads it automatically at startup (or pass -env <path> to point elsewhere).
# Real environment variables always win over what is written here.
#
# Every value below is a placeholder. Put the real base URL, secret, credentials
# and session defaults in fc-proxy.env only - that file is gitignored and must
# never be committed.

# ---- Flexcube target -------------------------------------------------------
CHANNEL_SANGAM_BASE_URL=https://flexcube.internal.example
APP_ENV=uat                       # production|uat use OAuth; anything else uses static-dev-token

# ---- Secrets ---------------------------------------------------------------
API_SECRET=73656372657473         # AES shared secret, hex-encoded
# FC_PROXY_SECRET_RAW=secrets     # ...or paste the secret literally instead of hex
SANGAM_CLIENT_ID=
SANGAM_CLIENT_SECRET=

# ---- Proxy ------------------------------------------------------------------
FC_PROXY_PORT=9090
FC_PROXY_DB=fc-proxy-ledger.db    # the SQLite ledger file
FC_PROXY_OPERATOR=                # who is testing; defaults to the Windows username
FC_PROXY_TIMEOUT_SECONDS=60
FC_PROXY_INSECURE_TLS=false       # true if the jump server hits a self-signed cert
FC_PROXY_VERBOSE=true

# ---- SessionContext defaults (overridable per request from Postman) --------
FC_PROXY_SERVICE_CODE=S001
FC_PROXY_BANK_CODE=100
FC_PROXY_BRANCH=1
FC_PROXY_SESSION_USER_ID=USER
FC_PROXY_SESSION_USER_NO=1
FC_PROXY_SESSION_CHANNEL=API
FC_PROXY_CHANNEL=sangam           # drives the x-user-id header: <PREFIX>_SANGAM
FC_PROXY_USER_ID_PREFIX=BANK      # the x-user-id prefix the upstream expects
FC_PROXY_CHANNEL_ID=web           # sent as the x-channel-id header
